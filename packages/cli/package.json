{
	"name": "labsui",
	"version": "0.1.0",
	"description": "Add labsUI components to your React + Tailwind v4 project: shadcn-style primitives with macOS polish and spring motion.",
	"type": "module",
	"bin": {
		"labsui": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=18.17"
	},
	"scripts": {
		"build": "bun build src/index.ts --target node --outfile dist/index.js",
		"prepublishOnly": "bun run build"
	},
	"keywords": [
		"react",
		"tailwindcss",
		"components",
		"shadcn",
		"cli",
		"nextjs",
		"motion"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kznlabs/labsUI.git",
		"directory": "packages/cli"
	},
	"homepage": "https://github.com/kznlabs/labsUI",
	"license": "MIT"
}
