{
	"name": "@kznlabs/labsui",
	"version": "0.1.14",
	"description": "Add labsUI components to your React + Tailwind v4 project, by hand or through your coding agent over MCP: code you own, exact props, updates that merge your edits.",
	"type": "module",
	"mcpName": "io.github.kznlabs/labsui",
	"bin": {
		"labsui": "dist/index.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "bun build src/index.ts --target node --outfile dist/index.js",
		"prepublishOnly": "cd ../.. && bun run cli:build"
	},
	"keywords": [
		"react",
		"tailwindcss",
		"components",
		"cli",
		"mcp",
		"agents",
		"nextjs",
		"motion"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kznlabs/labsUI.git",
		"directory": "packages/cli"
	},
	"homepage": "https://kznlabs.github.io/labsUI",
	"license": "MIT"
}
