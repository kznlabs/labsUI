{
	"config": {
		"MD013": { "code_blocks": false, "tables": false },
		"MD010": { "code_blocks": false },
		"MD033": { "allowed_elements": ["a", "picture", "source", "img"] }
	},
	"globs": ["**/*.md"],
	"ignores": [
		"AGENTS.md",
		"**/node_modules/**",
		".next/**",
		"out/**",
		"public/components/**",
		"playwright-report/**",
		"test-results/**"
	]
}
